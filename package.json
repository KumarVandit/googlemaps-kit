{
  "name": "googlemaps-kit",
  "version": "0.9.0",
  "description": "TypeScript SDK + Bubble Tea TUI for Google Maps and public Google consumer services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./translate": {
      "import": {
        "types": "./dist/translate.d.ts",
        "default": "./dist/translate.js"
      }
    },
    "./news": {
      "import": {
        "types": "./dist/news.d.ts",
        "default": "./dist/news.js"
      }
    },
    "./trends": {
      "import": {
        "types": "./dist/trends.d.ts",
        "default": "./dist/trends.js"
      }
    },
    "./finance": {
      "import": {
        "types": "./dist/finance.d.ts",
        "default": "./dist/finance.js"
      }
    },
    "./flights": {
      "import": {
        "types": "./dist/flights.d.ts",
        "default": "./dist/flights.js"
      }
    },
    "./hotels": {
      "import": {
        "types": "./dist/hotels.d.ts",
        "default": "./dist/hotels.js"
      }
    },
    "./youtube": {
      "import": {
        "types": "./dist/youtube.d.ts",
        "default": "./dist/youtube.js"
      }
    },
    "./lens": {
      "import": {
        "types": "./dist/lens.d.ts",
        "default": "./dist/lens.js"
      }
    },
    "./books": {
      "import": {
        "types": "./dist/books.d.ts",
        "default": "./dist/books.js"
      }
    },
    "./gemini-web": {
      "import": {
        "types": "./dist/gemini-web.d.ts",
        "default": "./dist/gemini-web.js"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      }
    }
  },
  "bin": {
    "googlemaps-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    ".github/assets/banner.png"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc -p tsconfig.check.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm run type-check && npm test",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:live": "GMAPS_LIVE=1 vitest run tests/live",
    "test:google-public:live": "GMAPS_LIVE=1 FINANCE_LIVE=1 GOOGLE_TRAVEL_LIVE=1 vitest run tests/live/google-translate.test.ts tests/live/google-news.test.ts tests/live/trends.test.ts tests/live/finance.test.ts tests/live/google-travel.test.ts tests/live/google-media.test.ts tests/live/google-ai-books.test.ts",
    "preexample": "npm run build",
    "example:quick-start": "tsx examples/quick-start.ts",
    "example:search": "tsx examples/search-text.ts",
    "example:pagination": "tsx examples/search-pagination.ts",
    "example:place": "tsx examples/place-get.ts",
    "example:place-full": "tsx examples/place-full.ts",
    "example:reviews": "tsx examples/reviews-list.ts",
    "example:directions": "tsx examples/directions-get.ts",
    "example:geocode": "tsx examples/geocode.ts",
    "example:suggest": "tsx examples/suggest.ts",
    "example:maps-url": "tsx examples/maps-url.ts",
    "example:grid-search": "tsx examples/grid-search.ts",
    "examples:all": "npm run build && tsx examples/run-all.ts",
    "verify:all": "tsx scripts/verify-all.ts",
    "smoke:daily": "tsx scripts/smoke-daily.ts",
    "api:serve": "tsx src/server/api-server.ts",
    "api:build": "tsc -p tsconfig.server.json"
  },
  "keywords": [
    "google-maps",
    "google-maps-api",
    "google-maps-scraper",
    "google-places-api",
    "places-api-alternative",
    "google-maps-without-api-key",
    "unofficial-google-maps-api",
    "free-google-maps-api",
    "google-maps-reviews-api",
    "google-maps-directions",
    "local-business-scraper",
    "maps-scraper",
    "places-api",
    "geocoding",
    "directions",
    "reviews",
    "typescript",
    "nodejs",
    "no-api-key",
    "sdk",
    "cli",
    "tui",
    "bubbletea"
  ],
  "author": "Kumar Vandit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KumarVandit/googlemaps-kit.git"
  },
  "bugs": {
    "url": "https://github.com/KumarVandit/googlemaps-kit/issues"
  },
  "homepage": "https://googlemapskit.vaandeetttt.com",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@oakoliver/bubbles": "^1.0.3",
    "@oakoliver/bubbletea": "^1.0.2",
    "@oakoliver/lipgloss": "^1.0.3",
    "geo-tz": "^8.1.8",
    "undici": "^6.28.0"
  }
}
